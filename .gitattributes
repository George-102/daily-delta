# 统一换行符为 LF。
# 本机 core.autocrlf=true，若不声明，全新克隆后工作区会变成 CRLF，
# 而 .prettierrc 里 endOfLine 是 "lf"，`pnpm format:check` 必然整片报错。
* text=auto eol=lf

# 二进制文件：禁止任何换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary

# Google Search Console 验证文件必须保持原样，不能被规范化
/public/google*.html -text